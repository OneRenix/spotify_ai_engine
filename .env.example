# Copy this file to .env and fill in the credentials for your provider.
# Never commit .env or share API keys.

# 1. Select the primary provider: google, openai, openrouter, or slm.
LLM_PROVIDER=openrouter

# 2. Optional provider-specific model overrides. Blank values use code defaults.
GOOGLE_MODEL_NAME=gemini-3.7-flash
# OPENAI_MODEL_NAME=gpt-4o-mini
# Get your Open AI models here: https://developers.openai.com/api/docs/models

# Optional override; unset or leave blank to use OpenRouter's free-model router.
OPENROUTER_MODEL_NAME=
# OPENROUTER_MODEL_NAME=poolside/laguna-s-2.1:free
# OPENROUTER_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_MODEL_NAME=google/gemma-4-31b-it:free

# 3. Hosted provider credentials and OpenRouter settings.
# OpenAI: required when LLM_PROVIDER=openai.
OPENAI_API_KEY=

# OpenRouter: required for direct use or Google-to-OpenRouter fallback.
# --- Get your API Key from https://openrouter.ai   
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_TOKENS=4096

# Google: set either GEMINI_API_KEY or GOOGLE_API_KEY.
# --- Get your API Key from https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=

# 4. Local SLM: OpenAI-compatible endpoint, such as Ollama.
SLM_BASE_URL=http://localhost:11434/v1
SLM_API_KEY=ollama
